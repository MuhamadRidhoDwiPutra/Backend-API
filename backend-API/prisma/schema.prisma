// This is your Prisma schema file,
// learn more about it in our docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  email     String   @db.VarChar(255)
  password  String   @db.VarChar(255)
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@unique([email])
  @@index([email], name: "idx_users_email")
  @@index([role], name: "idx_users_role")
  @@map("users")
}

enum Role {
  ADMIN
  CUSTOMER
}

model Product {
  id          String    @id @default(uuid())
  name        String    @db.VarChar(255)
  description String?   @db.Text
  price       Decimal   @db.Decimal(12, 2)
  stock       Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  orderItems OrderItem[]

  @@index([name], name: "idx_products_name")
  @@index([deletedAt], name: "idx_products_deleted")
  @@index([price], name: "idx_products_price")
  @@map("products")
}

model Order {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  totalAmount Decimal     @db.Decimal(12, 2)
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@index([userId], name: "idx_orders_user_id")
  @@index([status], name: "idx_orders_status")
  @@index([createdAt], name: "idx_orders_created")
  @@map("orders")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  quantity  Int
  price     Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId], name: "idx_order_items_order_id")
  @@index([productId], name: "idx_order_items_product")
  @@map("order_items")
}